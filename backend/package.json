{
  "name": "ai-callassist-backend", 
  "version": "1.0.0",
  "description": "Backend API for AI CallAssist appointment booking solution",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "babel src -d dist",
    "test": "jest --testTimeout=10000",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "express": "^4.18.0",
    "cors": "^2.8.0",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.0",
    "bcryptjs": "^2.4.0",
    "jsonwebtoken": "^9.0.0",
    "joi": "^17.9.0",
    "mongoose": "^7.4.0",
    "winston": "^3.10.0",
    "rate-limiter-flexible": "^3.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.0",
    "@babel/core": "^7.22.0", 
    "@babel/preset-env": "^7.22.0",
    "nodemon": "^3.0.0",
    "jest": "^29.6.0",
    "supertest": "^6.3.0",
    "eslint": "^8.45.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}